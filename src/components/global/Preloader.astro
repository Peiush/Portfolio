---
---

<div
  id="preloader"
  class="fixed inset-0 z-[9999] bg-[#F9F8F6] flex flex-col items-center justify-center"
>
  <div class="absolute top-0 inset-x-0 h-px bg-[#E6E4DF]/60"></div>
  <div class="absolute bottom-0 inset-x-0 h-px bg-[#E6E4DF]/60"></div>
  <div class="absolute left-1/2 inset-y-0 w-px bg-[#E6E4DF]/20"></div>

  <div class="relative flex flex-col items-center gap-12">
    <div
      id="preloader-avatar"
      class="w-48 h-48 rounded-full bg-white border border-[#E6E4DF] p-5 shadow-[0_8px_24px_rgba(0,0,0,0.01)]"
    >
      <svg viewBox="0 0 120 120" fill="none" stroke="#1C1C1C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <defs>
          <pattern id="preloader-check" width="8" height="8" patternUnits="userSpaceOnUse"><rect width="8" height="8" fill="#fff" stroke="none"></rect><path d="M0 2H8M2 0V8" stroke="#1C1C1C" stroke-width="1"></path></pattern>
        </defs>
        <path d="M16 108C18 92 34 84 50 80L60 94 70 80C86 84 102 92 104 108Z" fill="url(#preloader-check)"></path>
        <path d="M52 66V82L60 94 68 82V66Z" fill="#B98254"></path>
        <path d="M50 80L42 86 48 94 60 96ZM70 80L78 86 72 94 60 96Z" fill="url(#preloader-check)" stroke="#DC2626"></path>
        <path d="M40 34C40 20 50 14 60 14S80 20 80 34V46C80 54 77 60 72 64L66 70C64 72 62 73 60 73S56 72 54 70L48 64C43 60 40 54 40 46Z" fill="#C48B5A"></path>
        <path d="M40 40C41 50 48 58 56 59H64C72 58 79 50 80 40V46C80 54 77 60 72 64L66 70C64 72 62 73 60 73S56 72 54 70L48 64C43 60 40 54 40 46Z" fill="#1C1C1C" stroke="none" opacity=".95"></path>
        <path d="M39 38C35 22 44 9 60 8C76 7 85 21 81 38C80 30 77 26 74 24L71 28 68 22 64 28 60 21 56 28 52 22 48 28 45 24C42 28 40 33 39 38Z" fill="#1C1C1C" stroke-width="1.5"></path>
        <path d="M40 40C39 46 40 52 42 56L45 48C44 44 44 40 45 36ZM80 40C81 46 80 52 78 56L75 48C76 44 76 40 75 36Z" fill="#1C1C1C" stroke="none" opacity=".45"></path>
        <path d="M43 37Q50 33 56 37M64 37Q70 33 77 37" stroke-width="2.6"></path>
        <path d="M44 44Q50 40 56 44Q50 48 44 44ZM64 44Q70 40 76 44Q70 48 64 44Z" fill="#fff" stroke-width="1.4"></path>
        <circle id="preloader-pupil-l" cx="50" cy="44" r="2.2" fill="#1C1C1C" stroke="none"></circle>
        <circle id="preloader-pupil-r" cx="70" cy="44" r="2.2" fill="#1C1C1C" stroke="none"></circle>
        <path d="M60 45L58 52Q60 54 63 52" stroke-width="1.5"></path>
        <path d="M50 58C54 54 58 57 60 56 62 57 66 54 70 58 66 60 63 59 60 59 57 59 54 60 50 58Z" fill="#1C1C1C" stroke="none"></path>
        <ellipse cx="60" cy="63.5" rx="5" ry="2" fill="#B67A4C" stroke="none"></ellipse>
        <path d="M56 63Q60 66 64 63" stroke-width="1.5"></path>
      </svg>
    </div>

    <div class="flex flex-col items-center gap-3">
      <div class="flex items-baseline text-[#1C1C1C]">
        <span id="preloader-count" class="font-serif font-extralight text-5xl md:text-6xl tabular-nums">00</span>
        <span class="text-xs font-mono tracking-widest ml-1 text-[#8C8A84]">%</span>
      </div>
      <p class="text-[9px] font-mono tracking-[0.6em] uppercase text-[#8C8A84]">Crafting</p>
    </div>

    <div class="w-48 h-px bg-[#E6E4DF]">
      <div id="preloader-bar" class="h-full bg-[#4f46e5]" style="width:0%"></div>
    </div>
  </div>
</div>

<script>
  import { gsap } from "../../lib/gsap";
  import { prefersReducedMotion } from "../../lib/motion";

  const el = document.getElementById("preloader");
  if (el) {
    const done = () => {
      window.__loaderComplete = true;
      window.dispatchEvent(new Event("loaderComplete"));
    };

    if (prefersReducedMotion()) {
      done();
      el.remove();
    } else {
      const avatar = document.getElementById("preloader-avatar")!;
      const count = document.getElementById("preloader-count")!;
      const bar = document.getElementById("preloader-bar")!;
      const pupilL = document.getElementById("preloader-pupil-l")!;
      const pupilR = document.getElementById("preloader-pupil-r")!;

      history.scrollRestoration = "manual";
      window.scrollTo(0, 0);
      document.getElementById("hero")?.scrollIntoView({ behavior: "instant" as ScrollBehavior });
      document.body.style.overflow = "hidden";

      const block = (e: Event) => e.preventDefault();
      const keys = new Set(["ArrowUp", "ArrowDown", " ", "Space", "PageUp", "PageDown", "Home", "End"]);
      const blockKey = (e: KeyboardEvent) => {
        if (keys.has(e.key) || keys.has(e.code)) e.preventDefault();
      };
      window.addEventListener("wheel", block, { passive: false });
      window.addEventListener("touchmove", block, { passive: false });
      window.addEventListener("keydown", blockKey);

      const float = gsap.to(avatar, { y: -10, duration: 1.5, yoyo: true, repeat: -1, ease: "power1.inOut" });

      const state = { n: 0 };
      gsap.to(state, {
        n: 100,
        duration: 2.5,
        ease: "power2.inOut",
        onUpdate() {
          const v = Math.round(state.n);
          count.textContent = String(v).padStart(2, "0");
          bar.style.width = `${v}%`;
          const dx = -1.8 + (state.n / 100) * 3.6;
          gsap.set([pupilL, pupilR], { x: dx });
        },
        onComplete() {
          done();
          gsap
            .timeline({
              onComplete() {
                document.body.style.overflow = "";
                window.removeEventListener("wheel", block);
                window.removeEventListener("touchmove", block);
                window.removeEventListener("keydown", blockKey);
                float.kill();
                el.remove();
              },
            })
            .to(avatar, { scale: 0.85, opacity: 0, duration: 0.4, ease: "power2.in" })
            .to(
              el,
              { clipPath: "polygon(0 0,100% 0,100% 0,0 0)", duration: 1.1, ease: "power4.inOut" },
              "-=0.15",
            );
        },
      });
    }
  }
</script>
