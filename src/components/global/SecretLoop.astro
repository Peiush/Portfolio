---
interface Props { position: "top" | "bottom" }
const { position } = Astro.props;
---

<section data-lis-segment={position} hidden class="relative h-[300dvh] bg-zinc-950" aria-hidden="true">
  <div class="sticky top-0 h-dvh overflow-hidden flex flex-col items-center justify-center">
    <div class="absolute inset-0 opacity-[.12]" style="background-image:radial-gradient(#fff 1px,transparent 1px);background-size:20px 20px"></div>

    <svg viewBox="0 0 1014 978" class="relative w-[320px] md:w-[500px] h-auto" fill="none" stroke-linecap="round" stroke-linejoin="round" focusable="false">
      <path data-lis-path="main" d="M507 40 V938" stroke="#f4f4f5" stroke-width="6"></path>
      <path data-lis-path="a" d="M507 200 C 260 230, 260 420, 400 520 S 507 560 507 620" stroke="#38bdf8" stroke-width="6"></path>
      <path data-lis-path="b" d="M507 340 C 760 370, 780 560, 620 660 S 507 720 507 780" stroke="#a78bfa" stroke-width="6"></path>
      {[40, 200, 340, 620, 780, 938].map((y) => <circle data-lis-node cx="507" cy={y} r="14" fill="#09090b" stroke="#f4f4f5" stroke-width="5"></circle>)}
    </svg>

    <div class="relative mt-6 flex gap-2" aria-hidden="true">
      {Array.from({ length: 7 }, (_, i) => <span data-lis-dot class="w-2.5 h-2.5 rounded-full bg-[#3F3F46] transition-all duration-300"></span>)}
    </div>

    <p data-lis-text class="relative mt-6 flex items-center gap-3 text-3xl md:text-5xl text-white opacity-0 transition-opacity duration-700 px-6 text-center" style="font-family:'Architects Daughter','Caveat',cursive">
      <svg viewBox="0 0 24 24" class="w-8 h-8 text-sky-500 animate-flutter shrink-0" style="animation-play-state:paused" data-lis-icon fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><path d="M6 21V9a9 9 0 0 0 9 9"/></svg>
      // you found the loop. ship it.
    </p>
  </div>
</section>

<script>
  import { gsap, ScrollTrigger } from "../../lib/gsap";
  import { prefersReducedMotion } from "../../lib/motion";

  const main = document.querySelector("main") as HTMLElement | null;
  const segs = [...document.querySelectorAll<HTMLElement>("[data-lis-segment]")];
  const topSeg = segs.find((s) => s.dataset.lisSegment === "top");
  const botSeg = segs.find((s) => s.dataset.lisSegment === "bottom");

  if (main && topSeg && botSeg && !prefersReducedMotion() && !(window as any).__lisInit) {
    (window as any).__lisInit = true;
    let attempts = 0, lastAttempt = 0, unlocked = false, wrapped = false, touchY = 0, lastY = 0;
    const clamp01 = (n: number) => Math.min(1, Math.max(0, n));
    const maxY = () => document.documentElement.scrollHeight - window.innerHeight;
    const atBottom = () => window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 15;

    const chord = () => {
      try {
        const ac = new (window.AudioContext || (window as any).webkitAudioContext)();
        const filter = ac.createBiquadFilter();
        filter.type = "lowpass"; filter.frequency.value = 700;
        filter.connect(ac.destination);
        [110, 164.81, 220, 261.63, 329.63].forEach((f, i) => {
          const t = ac.currentTime + i * 0.06;
          const o = ac.createOscillator(), g = ac.createGain();
          o.type = "triangle"; o.frequency.value = f;
          g.gain.setValueAtTime(0, t);
          g.gain.linearRampToValueAtTime(0.08, t + 0.02);
          g.gain.exponentialRampToValueAtTime(0.0001, t + 2.5);
          o.connect(g).connect(filter);
          o.start(t); o.stop(t + 2.6);
        });
      } catch { /* sound is optional */ }
    };

    type Scene = { seg: HTMLElement; paths: { el: SVGPathElement; len: number; from: number; to: number }[]; nodes: SVGElement[]; dots: HTMLElement[]; text: HTMLElement; icon: SVGElement };
    let scenes: Scene[] = [];

    const build = (seg: HTMLElement): Scene => {
      const get = (k: string) => seg.querySelector<SVGPathElement>(`[data-lis-path="${k}"]`)!;
      const spans: [string, number, number][] = [["main", 0, 3500 / 6000], ["a", 3500 / 6000, 3500 / 6000 + 0.16], ["b", 3500 / 6000 + 0.16, 3500 / 6000 + 0.32]];
      return {
        seg,
        paths: spans.map(([k, from, to]) => { const el = get(k); const len = el.getTotalLength(); el.style.strokeDasharray = String(len); el.style.strokeDashoffset = String(len); return { el, len, from, to }; }),
        nodes: [...seg.querySelectorAll<SVGElement>("[data-lis-node]")],
        dots: [...seg.querySelectorAll<HTMLElement>("[data-lis-dot]")],
        text: seg.querySelector<HTMLElement>("[data-lis-text]")!,
        icon: seg.querySelector<SVGElement>("[data-lis-icon]")!,
      };
    };

    const render = () => {
      for (const s of scenes) {
        const r = s.seg.getBoundingClientRect();
        if (r.bottom < -50 || r.top > window.innerHeight + 50) continue;
        const p = wrapped ? 1 : clamp01(-r.top / Math.max(1, r.height - window.innerHeight));
        for (const { el, len, from, to } of s.paths) el.style.strokeDashoffset = String(len * (1 - clamp01((p - from) / (to - from))));
        s.nodes.forEach((n, i) => (n.style.opacity = p >= (i + 1) / 7 ? "1" : "0.25"));
        s.dots.forEach((d, i) => { const on = p >= (i + 1) / 7; d.style.background = on ? "#F4F4F5" : "#3F3F46"; d.style.transform = on ? "scale(1.1)" : "scale(1)"; });
        const show = p > 3400 / 6000;
        s.text.style.opacity = show ? "1" : "0";
        s.icon.style.animationPlayState = show ? "running" : "paused";
      }
    };

    const unlock = () => {
      unlocked = true;
      chord();
      const fontLink = document.createElement("link");
      fontLink.rel = "stylesheet";
      fontLink.href = "https://fonts.googleapis.com/css2?family=Architects+Daughter&display=swap";
      document.head.appendChild(fontLink);

      gsap.fromTo(main, { x: -12 }, { x: 12, duration: 0.04, repeat: 8, yoyo: true, ease: "none", onComplete: () => { gsap.set(main, { clearProps: "transform" }); } });
      segs.forEach((s) => { s.hidden = false; });
      main.insertBefore(topSeg, main.firstChild);
      window.scrollTo({ top: window.scrollY + topSeg.offsetHeight, behavior: "instant" as ScrollBehavior });
      ScrollTrigger.refresh();
      scenes = [build(topSeg), build(botSeg)];
      lastY = window.scrollY;
      render();
    };

    const wrapCheck = (dir: number) => {
      if (!unlocked) return;
      const y = window.scrollY;
      if (y >= maxY() - 1 && dir > 0) { wrapped = true; window.scrollTo({ top: 2, behavior: "instant" as ScrollBehavior }); render(); }
      else if (y <= 1 && dir < 0) { wrapped = true; window.scrollTo({ top: maxY() - 2, behavior: "instant" as ScrollBehavior }); render(); }
    };

    const attempt = (delta: number) => {
      if (unlocked) return wrapCheck(delta);
      if (delta <= 0 || !atBottom()) return;
      const now = performance.now();
      if (now - lastAttempt >= 800) {
        lastAttempt = now;
        if (++attempts >= 7) unlock();
      }
    };

    window.addEventListener("wheel", (e) => attempt(e.deltaY), { passive: true });
    window.addEventListener("touchstart", (e) => { touchY = e.touches[0].clientY; }, { passive: true });
    window.addEventListener("touchmove", (e) => { const d = touchY - e.touches[0].clientY; attempt(d); touchY = e.touches[0].clientY; }, { passive: true });
    window.addEventListener("scroll", () => {
      if (!unlocked) return;
      const y = window.scrollY;
      wrapCheck(y - lastY);
      lastY = window.scrollY;
      render();
    }, { passive: true });
  }
</script>
